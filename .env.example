# 复制为 .env 并填入真实值（.env 已 gitignore，不入库）
SECRET_KEY=替换为你的-django-secret-key
DEBUG=False
ALLOWED_HOSTS=fund.whatsyourname.top,49.234.26.95,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://fund.whatsyourname.top
SITE_HOST=https://fund.whatsyourname.top

# DeepSeek key 加密密钥（留空则首次运行时自动生成并写回此文件）
JK_FERNET_KEY=

# QQ 邮箱 SMTP（发件出口）
EMAIL_HOST_USER=your@qq.com
EMAIL_HOST_PASSWORD=你的QQ邮箱SMTP授权码（非登录密码）
DEFAULT_FROM_EMAIL=your@qq.com

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
